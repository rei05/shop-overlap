{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "paths": {
      "@shop-overlap/api-contract": ["../api-contract/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "data/**/*.json"]
}
