// Copy this file to Secrets.xcconfig. Never commit the copied file.
// Restrict this key to the iOS bundle identifier and Maps SDK for iOS.
GOOGLE_MAPS_IOS_API_KEY = replace-with-an-ios-restricted-key

// Public HTTPS URLs used by the iOS app.
API_BASE_URL = https:/$()/api.example.com
LEGAL_BASE_URL = https:/$()/www.example.com
