{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "WebWorker"],
    "strict": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types"],
    "paths": {
      "@shop-overlap/api-contract": ["../../packages/api-contract/src/index.ts"],
      "@shop-overlap/chain-catalog": ["../../packages/chain-catalog/src/index.ts"]
    }
