{
  "name": "shop-overlap",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/api",
    "packages/*"
  ],
  "scripts": {
    "api:dev": "npm run dev --workspace @shop-overlap/api",
    "api:deploy": "npm run deploy --workspace @shop-overlap/api",
    "ios:dev": "bash scripts/dev-ios.sh",
    "ios:run": "bash apps/ios/Scripts/run-simulator.sh",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "ios:test": "xcodebuild test -project apps/ios/ShopOverlap.xcodeproj -scheme ShopOverlap -destination 'platform=iOS Simulator,OS=latest,name=iPhone 17e' -skipPackagePluginValidation CODE_SIGNING_ALLOWED=NO",
    "contract:generate": "npm run generate --workspace @shop-overlap/api-contract",
    "contract:check": "npm run check:generated --workspace @shop-overlap/api-contract",
    "catalog:generate": "npm run generate --workspace @shop-overlap/chain-catalog",
    "catalog:check": "npm run catalog:generate && git diff --exit-code -- packages/chain-catalog/data/chains.jp.json",
    "verify": "npm run contract:check && npm run catalog:check && npm run typecheck && npm test"
  }
}
